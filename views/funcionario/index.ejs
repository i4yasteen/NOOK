<h3 class="mt-5">Funcionários</h3>

<a href="/funcionarios/novo" class="btn btn-primary mb-3">Novo Funcionário</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>CPF</th>
            <th>E-mail</th>
            <th>Telefone</th>
            <th>Função</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <% listaFuncionarios.forEach(funcionario => { %>
            <tr>
                <td><%= funcionario.nome %></td>
                <td><%= funcionario.cpf %></td>
                <td><%= funcionario.email %></td>
                <td><%= funcionario.telefone %></td>
                <td><%- _h.rotuloFuncao(funcionario.funcao) %></td>
                <td>
                    <a href="/funcionarios/<%= funcionario.id %>/atualizacao" class="btn btn-sm btn-secondary">Atualizar</a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>
