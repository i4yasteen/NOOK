<h3>Funcionários</h3>

<a href="/funcionarios/novo" class="btn btn-primary mb-3">Novo Funcionário</a>

<div class="table-responsive"><table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Função</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <% listaFuncionarios.forEach(funcionario => { %>
            <tr>
                <td><%= funcionario.nome %></td>
                <td><%= funcionario.email %></td>
                <td><%- _h.rotuloFuncao(funcionario.funcao) %></td>
                <td>
                    <a href="/funcionarios/<%= funcionario.id %>/atualizacao" class="btn btn-sm btn-secondary me-1">Atualizar</a>
                    <a href="/funcionarios/<%= funcionario.id %>/exclusao" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table></div>
