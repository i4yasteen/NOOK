<% const erros = validationErrors(locals.errors); %>
<% const livro = locals.livro || {} %>

<h3 class="mt-5">
    <% if (livro?.id) { %>
        Atualização do
    <% } else { %>
        Novo  
    <% } %>
    
    Livro - <%= livro?.titulo %> 
    <%- livro?.id ? _h.rotuloEstoque(livro?.quantidade) : '' %>
</h3>

<form action="<%= livro?.id ? `/livros/${livro.id}/atualizacao` : '/livros/novo' %>" method="post">

    <% if (erros.all.length) { %>
        <div class="alert alert-danger">
            <h6>Não foi possível salvar o livro</h6>
            <ul>
                <% erros.all.forEach(mensagem => { %>
                    <li><%= mensagem %></li>
                <% }) %>
            </ul>
        </div> 
    <% } %>

    <div class="form-group mb-3">
        <label for="titulo" class="form-label">Título</label>
        <input type="text" class="form-control" name="titulo" value="<%= livro?.titulo %>" placeholder="Informe o título do livro">
    </div>

    <div class="form-group mb-3">
        <label for="autor" class="form-label">Autor</label>
        <input type="text" class="form-control" name="autor" value="<%= livro?.autor %>" placeholder="Informe o autor">
    </div>

    <div class="form-group mb-3">
        <label for="ano" class="form-label">Ano</label>
        <input type="number" class="form-control" name="ano" value="<%= livro?.ano %>" placeholder="Informe o ano">
    </div>

    <div class="form-group mb-3">
        <label for="quantidade" class="form-label">Quantidade</label>
        <input type="number" class="form-control" name="quantidade" value="<%= livro?.quantidade %>" placeholder="Informe a quantidade em estoque">
    </div>

    <div class="form-group mb-3">
        <label for="capa" class="form-label">Capa (URL)</label>
        <input type="text" class="form-control" name="capa" value="<%= livro?.capa %>" placeholder="URL da imagem da capa">
    </div>

    <button type="submit" class="btn btn-primary">Salvar</button>
    <a href="/livros" class="btn btn-secondary">Cancelar</a>
</form>
