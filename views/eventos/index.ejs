<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Eventos</h1><p class="text-muted">Agenda de encontros e atividades literárias.</p></div><a class="btn btn-nook" href="/eventos/novo">+ Cadastrar evento</a></div>
<div class="row g-4"><% eventos.forEach(e=>{ %><div class="col-md-6"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-muted"><%=dateFormat(e.data)%> · <%=e.horario%></div><h4 class="mt-2"><%=e.titulo%></h4><p><%=e.descricao%></p><div><strong>Local:</strong> <%=e.local%> · <strong>Vagas:</strong> <%=e.vagas%></div><div class="mt-3"><a class="btn btn-sm btn-outline-secondary" href="/eventos/<%=e.id%>/editar">Editar</a> <form class="d-inline" method="post" action="/eventos/<%=e.id%>/excluir"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Excluir este evento?')">Excluir</button></form></div></div></div></div><% }) %></div>
