<h1><%=evento?'Editar Evento':'Cadastrar Evento'%></h1><p class="text-muted">Dados previstos no requisito RF2.</p>
<form method="post" action="<%=evento?'/eventos/'+evento.id:'/eventos'%>" class="card p-4 shadow-sm"><div class="row g-3">
<div class="col-md-8"><label class="form-label">Título</label><input class="form-control" name="titulo" required value="<%=evento?.titulo||''%>"></div><div class="col-md-4"><label class="form-label">Data</label><input class="form-control" type="date" name="data" required value="<%=evento?.data ? new Date(evento.data).toISOString().slice(0,10):''%>"></div>
<div class="col-12"><label class="form-label">Descrição</label><textarea class="form-control" name="descricao" rows="4" required><%=evento?.descricao||''%></textarea></div>
<div class="col-md-4"><label class="form-label">Horário</label><input class="form-control" type="time" name="horario" required value="<%=evento?.horario||''%>"></div><div class="col-md-4"><label class="form-label">Local</label><input class="form-control" name="local" required value="<%=evento?.local||''%>"></div><div class="col-md-4"><label class="form-label">Vagas</label><input class="form-control" type="number" min="1" name="vagas" value="<%=evento?.vagas||30%>"></div>
<div class="col-12"><label class="form-label">Imagem/banner (URL)</label><input class="form-control" name="imagem" value="<%=evento?.imagem||''%>"></div></div><div class="mt-4"><button class="btn btn-nook">Salvar</button> <a class="btn btn-outline-secondary" href="/eventos">Cancelar</a></div></form>
