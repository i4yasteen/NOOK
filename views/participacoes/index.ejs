<h1 class="mb-4">Participações em eventos</h1>
<form method="post" action="/participacoes" class="card p-4 mb-4 shadow-sm"><div class="row g-3 align-items-end"><div class="col-md-5"><label class="form-label">Cliente</label><select class="form-select" name="clienteId" required><option value="">Selecione</option><%clientes.forEach(c=><option value="<%=c.id%>"><%=c.nome%></option>)%></select></div><div class="col-md-5"><label class="form-label">Evento</label><select class="form-select" name="eventoId" required><option value="">Selecione</option><%eventos.forEach(e=><option value="<%=e.id%>"><%=e.titulo%> — <%=dateFormat(e.data)%></option>)%></select></div><div class="col-md-2"><button class="btn btn-nook w-100">Registrar</button></div></div></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Cliente</th><th>Evento</th><th>Data do registro</th></tr></thead><tbody><%participacoes.forEach(p=><tr><td><%=p.clienteNome%></td><td><%=p.eventoTitulo%></td><td><%=dateFormat(p.dataRegistro)%></td></tr>)%></tbody></table></div>
