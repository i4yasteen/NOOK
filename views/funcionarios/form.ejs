<h1><%=funcionario?'Editar Funcionário':'Cadastrar Funcionário'%></h1><form method="post" action="<%=funcionario?'/funcionarios/'+funcionario.id:'/funcionarios'%>" class="card p-4 shadow-sm"><div class="row g-3">
<div class="col-md-6"><label class="form-label">Nome</label><input class="form-control" name="nome" required value="<%=funcionario?.nome||''%>"></div><div class="col-md-3"><label class="form-label">CPF</label><input class="form-control" name="cpf" required value="<%=funcionario?.cpf||''%>"></div><div class="col-md-3"><label class="form-label">Telefone</label><input class="form-control" name="telefone" required value="<%=funcionario?.telefone||''%>"></div><div class="col-md-7"><label class="form-label">E-mail</label><input class="form-control" type="email" name="email" required value="<%=funcionario?.email||''%>"></div><div class="col-md-5"><label class="form-label">Função</label><input class="form-control" name="funcao" required value="<%=funcionario?.funcao||''%>"></div></div><div class="mt-4"><button class="btn btn-nook">Salvar</button> <a class="btn btn-outline-secondary" href="/funcionarios">Cancelar</a></div></form>
