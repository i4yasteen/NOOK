<!DOCTYPE html>
<html lang="pt-BR" class="h-100" data-bs-theme="light">
<head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#493426">
    <title><%= typeof titulo !== 'undefined' ? titulo : 'Nook | Cafeteria e Sebo' %></title>
    <link href="/css/bootstrap.min.css" rel="stylesheet"><link href="/css/style.css" rel="stylesheet">
</head>
<body class="d-flex flex-column h-100">
<header><nav class="navbar navbar-expand-lg navbar-dark"><div class="container">
    <a class="navbar-brand" href="/painel">nook</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Abrir menu"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="navbarNav"><ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/painel">Início</a></li>
        <% if (nookUser && nookUser.role === 'funcionario') { %>
          <li class="nav-item"><a class="nav-link" href="/livros">Livros</a></li><li class="nav-item"><a class="nav-link" href="/eventos">Eventos</a></li>
        <% } else if (nookUser && nookUser.role === 'cliente') { %>
          <li class="nav-item"><a class="nav-link" href="/livros">Livros</a></li><li class="nav-item"><a class="nav-link" href="/eventos">Eventos</a></li><li class="nav-item"><a class="nav-link" href="/reservas/novo">Reservar</a></li><li class="nav-item"><a class="nav-link" href="/participar/novo">Participar</a></li>
        <% } %>
        <% if (nookUser) { %><li class="nav-item"><a class="nav-link" href="/logout">Sair</a></li><% } %>
    </ul></div>
</div></nav></header>
<main class="flex-shrink-0"><div class="container mt-4"><%- body %></div></main>
<footer class="footer mt-auto py-3"><div class="container text-center"><span class="text-muted">Nook Cafeteria e Sebo &copy; 2026 · Um bom livro, um bom café, um bom momento.</span></div></footer>
<script src="/js/bootstrap.bundle.min.js"></script></body></html>
