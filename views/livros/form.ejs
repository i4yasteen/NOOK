<h1><%= livro ? 'Editar Livro' : 'Cadastrar Livro' %></h1><p class="text-muted">Dados previstos no requisito RF1.</p>
<form method="post" action="<%= livro ? '/livros/'+livro.id : '/livros' %>" class="card p-4 shadow-sm">
<div class="row g-3"><div class="col-md-8"><label class="form-label">Título</label><input class="form-control" name="titulo" required value="<%= livro?.titulo||'' %>"></div><div class="col-md-4"><label class="form-label">Ano</label><input class="form-control" type="number" name="ano" required value="<%= livro?.ano||'' %>"></div><div class="col-md-8"><label class="form-label">Autor</label><input class="form-control" name="autor" required value="<%= livro?.autor||'' %>"></div><div class="col-md-4"><label class="form-label">Quantidade em estoque</label><input class="form-control" type="number" min="0" name="estoque" required value="<%= livro?.estoque||0 %>"></div><div class="col-12"><label class="form-label">Capa/imagem (URL)</label><input class="form-control" name="imagem" value="<%= livro?.imagem||'' %>"></div></div>
<div class="mt-4"><button class="btn btn-nook">Salvar</button> <a class="btn btn-outline-secondary" href="/livros">Cancelar</a></div></form>
