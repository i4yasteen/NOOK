<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Livros</h1><p class="text-muted">Catálogo e estoque da Nook.</p></div><a class="btn btn-nook" href="/livros/novo">+ Cadastrar livro</a></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Título</th><th>Autor</th><th>Ano</th><th>Estoque</th><th></th></tr></thead><tbody>
<% livros.forEach(l=>{ %><tr><td class="fw-semibold"><%= l.titulo %></td><td><%= l.autor %></td><td><%= l.ano %></td><td><span class="badge text-bg-<%= l.estoque>0?'success':'secondary' %>"><%= l.estoque %></span></td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/livros/<%=l.id%>/editar">Editar</a> <form class="d-inline" method="post" action="/livros/<%=l.id%>/excluir"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Excluir este livro?')">Excluir</button></form></td></tr><% }) %>
<% if(!livros.length){ %><tr><td colspan="5" class="text-center text-muted py-5">Nenhum livro cadastrado.</td></tr><% } %></tbody></table></div>
