<h3 class="mt-5">Clientes</h3>

<a href="/clientes/novo" class="btn btn-primary mb-3">Novo Cliente</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>CPF</th>
            <th>E-mail</th>
            <th>Telefone</th>
            <th>Endereço</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <% listaClientes.forEach(cliente => { %>
            <tr>
                <td><%= cliente.nome %></td>
                <td><%= cliente.cpf %></td>
                <td><%= cliente.email %></td>
                <td><%= cliente.telefone %></td>
                <td><%= cliente.endereco %></td>
                <td>
                    <a href="/clientes/<%= cliente.id %>/atualizacao" class="btn btn-sm btn-secondary">Atualizar</a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>
