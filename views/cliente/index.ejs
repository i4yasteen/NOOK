<h3>Clientes</h3>

<a href="/clientes/novo" class="btn btn-primary mb-3">Novo Cliente</a>

<div class="table-responsive"><table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Telefone</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <% listaClientes.forEach(cliente => { %>
            <tr>
                <td><%= cliente.nome %></td>
                <td><%= cliente.email %></td>
                <td><%= cliente.telefone %></td>
                <td>
                    <a href="/clientes/<%= cliente.id %>/atualizacao" class="btn btn-sm btn-secondary me-1">Atualizar</a>
                    <a href="/clientes/<%= cliente.id %>/exclusao" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table></div>
