<h1 class="h2">Reservar um livro</h1><p class="text-muted">Escolha o título que deseja reservar. Sua conta será identificada automaticamente.</p>
<% const erros = validationErrors(locals.errors); const reserva = locals.reserva || {}; %>
<% if (erros.all.length) { %><div class="alert alert-danger"><ul class="mb-0"><% erros.all.forEach(mensagem => { %><li><%= mensagem %></li><% }) %></ul></div><% } %>
<form action="/reservas/novo" method="post" class="form-card">
  <div class="mb-3"><label for="livroId" class="form-label">Livro</label><select id="livroId" class="form-select" name="livroId" required><option value="">Selecione um livro</option><% (listaLivros || []).forEach(livro => { %><option value="<%= livro.id %>" <%= String(reserva.livroId || '') === String(livro.id) ? 'selected' : '' %> <%= livro.quantidade < 1 ? 'disabled' : '' %>><%= livro.titulo %> — <%= livro.quantidade %> disponível(is)</option><% }) %></select></div>
  <button type="submit" class="btn btn-primary">Confirmar reserva</button> <a href="/livros" class="btn btn-outline-secondary">Voltar ao catálogo</a>
</form>
