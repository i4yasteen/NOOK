<h3>Reservas</h3>

<a href="/reservas/novo" class="btn btn-primary mb-3">Nova Reserva</a>

<div class="table-responsive"><table class="table table-striped">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Livro</th>
            <th>Data</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <% listaReservas.forEach(reserva => { %>
            <tr>
                <td><%= reserva.cliente.nome %></td>
                <td><%= reserva.livro.titulo %></td>
                <td><%= dateFormat(reserva.data) %></td>
                <td><%- _h.rotuloStatus(reserva.status) %></td>
                <td>
                    <a href="/reservas/<%= reserva.id %>/atualizacao" class="btn btn-sm btn-secondary me-1">Atualizar</a>
                    <a href="/reservas/<%= reserva.id %>/exclusao" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table></div>
