<h1 class="h2">Participar de um evento</h1><p class="text-muted">Escolha o encontro em que deseja participar. Sua conta será identificada automaticamente.</p>
<% const erros = validationErrors(locals.errors); const participar = locals.participar || {}; %>
<% if (erros.all.length) { %><div class="alert alert-danger"><ul class="mb-0"><% erros.all.forEach(mensagem => { %><li><%= mensagem %></li><% }) %></ul></div><% } %>
<form action="/participar/novo" method="post" class="form-card">
  <div class="mb-3"><label for="eventoId" class="form-label">Evento</label><select id="eventoId" class="form-select" name="eventoId" required><option value="">Selecione um evento</option><% (listaEventos || []).forEach(evento => { %><option value="<%= evento.id %>" <%= String(participar.eventoId || '') === String(evento.id) ? 'selected' : '' %>><%= evento.titulo %> — <%= evento.data %> às <%= evento.horario %></option><% }) %></select></div>
  <button type="submit" class="btn btn-primary">Confirmar participação</button> <a href="/eventos" class="btn btn-outline-secondary">Voltar aos eventos</a>
</form>
