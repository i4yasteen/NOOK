<h3 class="mt-5">Participações</h3>

<a href="/participar/novo" class="btn btn-primary mb-3">Nova Participação</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Evento</th>
            <th>Data</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <% listaParticipar.forEach(participar => { %>
            <tr>
                <td><%= participar.cliente.nome %></td>
                <td><%= participar.evento.nome %></td>
                <td><%= dateFormat(participar.data) %></td>
                <td>
                    <a href="/participar/<%= participar.id %>/atualizacao" class="btn btn-sm btn-secondary">Atualizar</a>
                    <a href="/participar/<%= participar.id %>/exclusao" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>
