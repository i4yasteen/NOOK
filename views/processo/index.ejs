<h1 class="mt-5">Consulta de Processos</h1>

<table class="table mt-3">
    <thead>
        <tr>
            <th>#</th>
            <th>Número</th>
            <th>Data</th>
            <th>Interessado</th>
            <th>Situação</th>
        </tr>
    </thead>
    <tbody>
        <% listaProcessos.forEach(function(processo, index) { %>
            <tr>
                <td><%= index + 1 %></td>
                <td><%= processo.numero %></td>
                <td><%= dateFormat(processo.data) %></td>
                <td><%= processo.interessado %></td>
                <td>
                    <span class="badge text-bg-secondary"><%= processo.situacao %></span>
                </td>
            </tr>
        <% }) %> 
    </tbody>
</table>